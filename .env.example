# Copy to .env for local development. Never commit filled secrets.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/zpantry_dev
SPRING_DATASOURCE_USERNAME=zpantry_dev
SPRING_DATASOURCE_PASSWORD=
ZPANTRY_PROFILE_ACTIVE=dev

# PayOS checkout (required to create a Z-Plus payment link). These must be public HTTPS URLs;
# PayOS redirects to the backend landing pages, which then open zpantry://payment/... on mobile.
ZPANTRY_PAYMENT_PAYOS_CLIENT_ID=
ZPANTRY_PAYMENT_PAYOS_API_KEY=
ZPANTRY_PAYMENT_PAYOS_CHECKSUM_KEY=
ZPANTRY_PAYMENT_PAYOS_RETURN_URL=https://api.your-domain.example/payment/success
ZPANTRY_PAYMENT_PAYOS_CANCEL_URL=https://api.your-domain.example/payment/cancel
# Optional: defaults to https://api-merchant.payos.vn/v2/payment-requests
ZPANTRY_PAYMENT_PAYOS_ENDPOINT=
# Register this public HTTPS callback in the PayOS merchant dashboard. It must never contain a secret.
# https://api.your-domain.example/api/payment/payos/webhook
